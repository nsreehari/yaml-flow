{
  "name": "yaml-flow",
  "version": "7.1.0",
  "description": "Unified workflow engine: step-machine (sequential) + event-graph (stateless DAG) with pluggable storage",
  "author": "",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "bin": {
    "board-live-cards-cli": "./cli/node/board-live-cards-cli.js",
    "card-store": "./cli/node/card-store-cli.js",
    "step-machine-cli": "./cli/node/step-machine-cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./step-machine": {
      "types": "./lib/step-machine/index.d.ts",
      "import": "./lib/step-machine/index.js",
      "require": "./lib/step-machine/index.cjs"
    },
    "./event-graph": {
      "types": "./lib/event-graph/index.d.ts",
      "import": "./lib/event-graph/index.js",
      "require": "./lib/event-graph/index.cjs"
    },
    "./stores": {
      "types": "./lib/stores/index.d.ts",
      "import": "./lib/stores/index.js",
      "require": "./lib/stores/index.cjs"
    },
    "./stores/memory": {
      "types": "./lib/stores/memory.d.ts",
      "import": "./lib/stores/memory.js",
      "require": "./lib/stores/memory.cjs"
    },
    "./stores/localStorage": {
      "types": "./lib/stores/localStorage.d.ts",
      "import": "./lib/stores/localStorage.js",
      "require": "./lib/stores/localStorage.cjs"
    },
    "./stores/file": {
      "types": "./lib/stores/file.d.ts",
      "import": "./lib/stores/file.js",
      "require": "./lib/stores/file.cjs"
    },
    "./batch": {
      "types": "./lib/batch/index.d.ts",
      "import": "./lib/batch/index.js",
      "require": "./lib/batch/index.cjs"
    },
    "./config": {
      "types": "./lib/config/index.d.ts",
      "import": "./lib/config/index.js",
      "require": "./lib/config/index.cjs"
    },
    "./continuous-event-graph": {
      "types": "./lib/continuous-event-graph/index.d.ts",
      "import": "./lib/continuous-event-graph/index.js",
      "require": "./lib/continuous-event-graph/index.cjs"
    },
    "./board-livegraph-runtime": {
      "types": "./lib/board-livegraph-runtime/index.d.ts",
      "import": "./lib/board-livegraph-runtime/index.js",
      "require": "./lib/board-livegraph-runtime/index.cjs"
    },
    "./inference": {
      "types": "./lib/inference/index.d.ts",
      "import": "./lib/inference/index.js",
      "require": "./lib/inference/index.cjs"
    },
    "./card-compute": {
      "types": "./lib/card-compute/index.d.ts",
      "import": "./lib/card-compute/index.js",
      "require": "./lib/card-compute/index.cjs"
    },
    "./storage-refs": {
      "types": "./lib/storage-refs.d.ts",
      "import": "./lib/storage-refs.js",
      "require": "./lib/storage-refs.cjs"
    },
    "./execution-refs": {
      "types": "./lib/execution-refs.d.ts",
      "import": "./lib/execution-refs.js",
      "require": "./lib/execution-refs.cjs"
    },
    "./board-live-cards-browser": {
      "types": "./cli/browser-api/board-live-cards-browser-adapter.d.ts",
      "import": "./cli/browser-api/board-live-cards-browser-adapter.js"
    },
    "./board-live-cards-node": {
      "types": "./cli/node/fs-board-adapter.d.ts",
      "import": "./cli/node/fs-board-adapter.js"
    },
    "./card-store-browser": {
      "types": "./cli/browser-api/card-store-browser-api.d.ts",
      "import": "./cli/browser-api/card-store-browser-api.js"
    },
    "./server-runtime": {
      "types": "./lib/server-runtime/index.d.ts",
      "import": "./lib/server-runtime/index.js"
    },
    "./package.json": "./package.json"
  },
  "browser": {
    "./stores/file": false
  },
  "files": [
    "lib",
    "cli",
    "examples",
    "!examples/**/runtime/**",
    "!examples/**/--base-ref/**",
    "!examples/**/cards/**/chats/**",
    "!examples/**/cards/**/files/**",
    "schema",
    "browser"
  ],
  "scripts": {
    "build": "npm run -s build:lib && npm run -s build:cli",
    "build:lib": "tsup --config tsup.config.ts",
    "build:cli": "tsup --config tsup.cli.config.ts",
    "build:browser": "tsup --config tsup.browser.config.ts && node scripts/generate-browser-integrity.mjs",
    "check:bundle-budget": "node scripts/check-bundle-budgets.mjs",
    "check:browser-bundle": "node scripts/check-browser-bundle-safety.mjs",
    "release:gate": "npm run -s build && npm run -s build:browser && npm run -s test:run && npm run -s check:bundle-budget && npm run -s check:browser-bundle",
    "standalone": "echo standalone is canonical; no assembly step required",
    "pycli:install": "python -m pip install -r standalone/requirements.txt",
    "pycli:install:venv": "c:/Users/sreenaga/ADO/ai-tool-evolver/.venv/Scripts/python.exe -m pip install -r standalone/requirements.txt",
    "pycli:install:py312": "py -3.12 -m pip install -r standalone/requirements.txt",
    "pycli:install:venv312": "./.venv312/Scripts/python.exe -m pip install -r standalone/requirements.txt",
    "build:example": "echo deprecated: standalone is canonical",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "npm run build && vitest run",
    "test:cli-parity": "echo removed: standalone canonical mode",
    "test:cli-parity:full": "echo removed: standalone canonical mode",
    "test:e2e": "python standalone/examples/portfolio-tracker/portfolio-tracker.py --run-pycli",
    "test:portfolio-tracker-server": "python standalone/examples/portfolio-tracker/portfolio-tracker-http-test.py --server py --port 7801",
    "test:example-board": "vitest run tests/examples/example-board.test.ts",
    "check:example-board": "npm run test:example-board && npm run validate:cards -- \"examples/example-board/cards/*.json\"",
    "validate:cards": "tsx scripts/validate-live-cards.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run build:browser && npm run check:bundle-budget && npm run check:browser-bundle"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/proper-lockfile": "^4.1.4",
    "jsdom": "^24.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "ajv-formats": "^3.0.1",
    "fast-glob": "^3.3.3",
    "proper-lockfile": "^4.1.2",
    "yaml": "^2.3.4"
  },
  "optionalDependencies": {
    "ajv": "^8.18.0"
  },
  "keywords": [
    "workflow",
    "state-machine",
    "yaml",
    "flow",
    "isomorphic",
    "browser",
    "nodejs",
    "declarative"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nsreehari/yaml-flow.git"
  },
  "engines": {
    "node": ">=18"
  }
}
