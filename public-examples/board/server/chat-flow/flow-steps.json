{
  "id": "chat-flow-steps",
  "settings": {
    "start_step": "read_chats",
    "max_total_steps": 10,
    "timeout_ms": 300000
  },
  "steps": {
    "read_chats": {
      "description": "Read chats from runtime storage via MCP inspect.chat-messages-on-cards",
      "expects_data": ["serverUrl", "boardId", "cardId"],
      "produces_data": ["chatMessages"],
      "input_validations": [
        "$type(serverUrl) = \"string\" and $length(serverUrl) > 0",
        "$type(boardId) = \"string\" and $length(boardId) > 0",
        "$type(cardId) = \"string\" and $length(cardId) > 0"
      ],
      "handler": {
        "type": "ref",
        "howToRun": "http:post",
        "whatToRun": {
          "kind": "http-url",
          "value": ""
        },
        "meta": "chat-handler",
        "argsMassaging": {
          "urlTemplate": "serverUrl & '/api/boards/' & boardId & '/mcp'",
          "bodyTemplate": "{ 'tool': 'inspect.chat-messages-on-cards', 'args': { 'card_id': cardId } }"
        },
        "outputTransforms": {
          "dataTemplate": "{ 'chatMessages': output.data.messages }"
        }
      },
      "transitions": {
        "success": "open_turn",
        "failure": "cleanup_failure",
        "error": "cleanup_failure"
      }
    },
    "open_turn": {
      "description": "Resolve the current user turn from flow-provided chat messages and parse any chat envelope options",
      "produces_data": ["boardId", "cardId", "boardSetupRoot", "boardBaseRef", "boardRuntimeDir", "runtimeStatusDir", "cardsDir", "projectRoot", "chatFlowRoot", "chatMessages", "userText", "lastChatEntryId", "turnId", "probe", "chatHandlerMode", "chatCopilotTimeoutMs", "probeAttachmentFileIdx", "serverUrl"],
      "input_validations": [
        "$type(cardId) = \"string\" and $length(cardId) > 0",
        "$type(chatMessages) = \"array\"",
        "$type(lastChatEntryId) = \"string\" and $length(lastChatEntryId) > 0",
        "$count($filter(chatMessages, function($message) { $message.id = lastChatEntryId and $message.role = \"user\" and $type($message.text) = \"string\" and $length($trim($message.text)) > 0 })) > 0"
      ],
      "handler": {
        "type": "compute-jsonata",
        "expr": [
          "data.boardId = $type(expects_data.boardId) = \"string\" ? expects_data.boardId : \"\"",
          "data.cardId = $type(expects_data.cardId) = \"string\" ? expects_data.cardId : \"\"",
          "data.boardSetupRoot = $type(expects_data.boardSetupRoot) = \"string\" ? expects_data.boardSetupRoot : \"\"",
          "data.boardBaseRef = $type(expects_data.boardBaseRef) = \"string\" ? expects_data.boardBaseRef : \"\"",
          "data.boardRuntimeDir = ($type(expects_data.boardRuntimeDir) = \"string\" and $length(expects_data.boardRuntimeDir) > 0) ? expects_data.boardRuntimeDir : \"runtime\"",
          "data.runtimeStatusDir = ($type(expects_data.runtimeStatusDir) = \"string\" and $length(expects_data.runtimeStatusDir) > 0) ? expects_data.runtimeStatusDir : \"runtime-out\"",
          "data.cardsDir = ($type(expects_data.cardsDir) = \"string\" and $length(expects_data.cardsDir) > 0) ? expects_data.cardsDir : \"cards\"",
          "data.projectRoot = $type(expects_data.projectRoot) = \"string\" ? expects_data.projectRoot : \"\"",
          "data.chatFlowRoot = $type(expects_data.chatFlowRoot) = \"string\" ? expects_data.chatFlowRoot : \"\"",
          "data.serverUrl = $type(expects_data.serverUrl) = \"string\" ? expects_data.serverUrl : \"\"",
          "data.chatMessages = expects_data.chatMessages",
          "data.lastChatEntryId = expects_data.lastChatEntryId",
          "data._currentUserMessage = $filter(expects_data.chatMessages, function($message) { $message.id = expects_data.lastChatEntryId and $message.role = \"user\" })[0]",
          "data.turnId = ($type(expects_data.turnId) = \"string\") ? expects_data.turnId : (($type(data._currentUserMessage.turn) = \"string\") ? data._currentUserMessage.turn : \"\")",
          "data._rawMessageText = $trim($string(data._currentUserMessage.text))",
          "data.probeAttachmentFileIdx = ($type(data._currentUserMessage.files) = \"array\" and $count(data._currentUserMessage.files) > 0) ? 0 : null",
          "data._marker = \"__probe__echo__probe__\"",
          "data._markerLen = $length(data._marker)",
          "data._isEchoProbe = $length(data._rawMessageText) >= (data._markerLen * 2) and $substring(data._rawMessageText, 0, data._markerLen) = data._marker and $substring(data._rawMessageText, $length(data._rawMessageText) - data._markerLen) = data._marker",
          "data._hasLegacyEnvelope = $length(data._rawMessageText) >= 2 and $substring(data._rawMessageText, 0, 1) = \"{\" and $substring(data._rawMessageText, $length(data._rawMessageText) - 1) = \"}\" and $count($match(data._rawMessageText, /^\\s*\\{\\s*\"(prompt|text|userText|query|probe|chatHandlerMode|chatTimeoutMs|chatCopilotTimeoutMs)\"/)) > 0",
          "data._legacyEnvelope = data._hasLegacyEnvelope ? $eval(data._rawMessageText) : null",
          "data._legacyPrompt = ($type(data._legacyEnvelope.prompt) = \"string\" and $length($trim(data._legacyEnvelope.prompt)) > 0) ? data._legacyEnvelope.prompt : (($type(data._legacyEnvelope.text) = \"string\" and $length($trim(data._legacyEnvelope.text)) > 0) ? data._legacyEnvelope.text : (($type(data._legacyEnvelope.userText) = \"string\" and $length($trim(data._legacyEnvelope.userText)) > 0) ? data._legacyEnvelope.userText : (($type(data._legacyEnvelope.query) = \"string\" and $length($trim(data._legacyEnvelope.query)) > 0) ? data._legacyEnvelope.query : null)))",
          "data.userText = data._isEchoProbe ? $trim($substring(data._rawMessageText, data._markerLen, $length(data._rawMessageText) - (data._markerLen * 2))) : (($type(data._legacyPrompt) = \"string\" and $length($trim(data._legacyPrompt)) > 0) ? $trim(data._legacyPrompt) : data._rawMessageText)",
          "data.probe = data._isEchoProbe ? true : (data._legacyEnvelope.probe = true or data._legacyEnvelope.probe = 1 or ($type(data._legacyEnvelope.probe) = \"string\" and $count($filter([\"1\", \"true\", \"yes\", \"on\"], function($value) { $value = $lowercase($trim(data._legacyEnvelope.probe)) })) > 0))",
          "data.chatHandlerMode = data._isEchoProbe ? \"echo-probe\" : (($type(data._legacyEnvelope.chatHandlerMode) = \"string\" and $length($trim(data._legacyEnvelope.chatHandlerMode)) > 0) ? $lowercase($trim(data._legacyEnvelope.chatHandlerMode)) : (data.probe ? \"probe\" : \"copilot\"))",
          "data.chatCopilotTimeoutMs = ($parsePositiveInt := function($value) { ($type($value) = \"number\" and $value > 0) ? $floor($value) : (($type($value) = \"string\" and $count($match($trim($value), /^[0-9]+$/)) > 0 and $number($trim($value)) > 0) ? $floor($number($trim($value))) : null) }; $legacyTimeout := $parsePositiveInt(data._legacyEnvelope.chatTimeoutMs); $legacyCopilotTimeout := $parsePositiveInt(data._legacyEnvelope.chatCopilotTimeoutMs); $fallbackTimeout := $parsePositiveInt(expects_data.chatCopilotTimeoutMs); $legacyTimeout ? $legacyTimeout : ($legacyCopilotTimeout ? $legacyCopilotTimeout : ($fallbackTimeout ? $fallbackTimeout : 300000)))",
          "result = \"success\""
        ]
      },
      "transitions": {
        "success": "select_assistant",
        "failure": "cleanup_failure",
        "error": "cleanup_failure"
      }
    },
    "select_assistant": {
      "description": "Choose Copilot by default, or the probe echo assistant when probe mode is enabled",
      "expects_data": ["probe", "chatHandlerMode"],
      "produces_data": ["selectedAssistant"],
      "handler": {
        "type": "compute-jsonata",
        "expr": [
          "data.selectedAssistant = (expects_data.probe = true or expects_data.probe = \"true\" or expects_data.probe = 1 or $lowercase($string(expects_data.chatHandlerMode)) = \"probe\" or $lowercase($string(expects_data.chatHandlerMode)) = \"echo-probe\") ? \"probe\" : \"copilot\"",
          "result = data.selectedAssistant"
        ]
      },
      "transitions": {
        "copilot": "copilot_assistant",
        "probe": "select_probe_reply_source",
        "failure": "cleanup_failure",
        "error": "cleanup_failure"
      }
    },
    "select_probe_reply_source": {
      "description": "Use attached file content for probe replies when the current user message carries a file",
      "expects_data": ["probeAttachmentFileIdx"],
      "produces_data": ["probeReplySource"],
      "handler": {
        "type": "compute-jsonata",
        "expr": [
          "data.probeReplySource = $type(expects_data.probeAttachmentFileIdx) = \"number\" ? \"attachment\" : \"echo\"",
          "result = data.probeReplySource"
        ]
      },
      "transitions": {
        "attachment": "probe_attachment_reply",
        "echo": "probe_assistant",
        "failure": "cleanup_failure",
        "error": "cleanup_failure"
      }
    },
    "probe_in_progress": {
      "description": "Append a probe-only in-progress system message via the host test endpoint before generating the deterministic echo reply",
      "expects_data": ["serverUrl", "boardId", "cardId", "turnId"],
      "input_validations": [
        "$type(serverUrl) = \"string\" and $length(serverUrl) > 0",
        "$type(boardId) = \"string\" and $length(boardId) > 0",
        "$type(cardId) = \"string\" and $length(cardId) > 0"
      ],
      "handler": {
        "type": "ref",
        "howToRun": "http:post",
        "whatToRun": {
          "kind": "http-url",
          "value": ""
        },
        "meta": "chat-handler",
        "argsMassaging": {
          "urlTemplate": "serverUrl & '/test-req/boards/' & boardId & '/chat/system-message'",
          "bodyTemplate": "{ 'cardId': cardId, 'text': 'in-progress', 'turn': turnId, 'files': [] }"
        }
      },
      "transitions": {
        "success": "write_reply",
        "failure": "cleanup_failure",
        "error": "cleanup_failure"
      }
    },
    "probe_attachment_reply": {
      "description": "Read the current probe attachment via MCP inspect.file-contents and use its content as the assistant reply",
      "expects_data": ["serverUrl", "boardId", "cardId", "probeAttachmentFileIdx"],
      "produces_data": ["replyText", "probeAttachmentMimeType", "probeAttachmentBodyBase64"],
      "input_validations": [
        "$type(serverUrl) = \"string\" and $length(serverUrl) > 0",
        "$type(boardId) = \"string\" and $length(boardId) > 0",
        "$type(cardId) = \"string\" and $length(cardId) > 0",
        "$type(probeAttachmentFileIdx) = \"number\" and probeAttachmentFileIdx >= 0"
      ],
      "handler": {
        "type": "ref",
        "howToRun": "http:post",
        "whatToRun": {
          "kind": "http-url",
          "value": ""
        },
        "meta": "chat-handler",
        "argsMassaging": {
          "urlTemplate": "serverUrl & '/api/boards/' & boardId & '/mcp-raw?resp=json-b64'",
          "bodyTemplate": "{ 'tool': 'inspect.file-contents', 'args': { 'card_id': cardId, 'file_idx': probeAttachmentFileIdx } }"
        },
        "outputTransforms": {
          "dataTemplate": "{ 'replyText': ($type(output.data.bodyBase64) = 'string' ? $base64decode(output.data.bodyBase64) : ''), 'probeAttachmentMimeType': output.data.mimeType, 'probeAttachmentBodyBase64': output.data.bodyBase64 }"
        }
      },
      "transitions": {
        "success": "probe_in_progress",
        "failure": "cleanup_failure",
        "error": "cleanup_failure"
      }
    },
    "copilot_assistant": {
      "description": "Run the Copilot-backed assistant logic to generate the reply from the resolved chat history",
      "expects_data": ["userText", "chatMessages", "boardId", "cardId", "boardSetupRoot", "boardRuntimeDir", "runtimeStatusDir", "cardsDir", "projectRoot", "chatFlowRoot", "chatCopilotTimeoutMs", "turnId"],
      "produces_data": ["replyText"],
      "input_validations": [
        "$type(userText) = \"string\"",
        "$type(chatMessages) = \"array\""
      ],
      "handler": {
        "type": "ref",
        "howToRun": "local-process",
        "whatToRun": {
          "kind": "process-name",
          "value": "node"
        },
        "argsMassaging": {
          "cmdTemplate": ["chatFlowRoot & '/copilot-chat/assistant.js'"],
          "stdinTemplate": "{ 'cardId': cardId, 'boardSetupRoot': boardSetupRoot, 'boardRuntimeDir': boardRuntimeDir, 'runtimeStatusDir': runtimeStatusDir, 'cardsDir': cardsDir, 'chatMessages': chatMessages, 'userText': userText, 'chatCopilotTimeoutMs': chatCopilotTimeoutMs, 'turnId': turnId }"
        },
        "meta": "chat-handler"
      },
      "transitions": {
        "success": "write_reply",
        "failure": "cleanup_failure",
        "error": "cleanup_failure"
      }
    },
    "probe_assistant": {
      "description": "Compute the deterministic echo assistant reply for echo-probe and test flows",
      "expects_data": ["userText"],
      "produces_data": ["replyText"],
      "input_validations": [
        "$type(userText) = \"string\""
      ],
      "handler": {
        "type": "compute-jsonata",
        "expr": [
          "data.replyText = \"Echo: \" & expects_data.userText",
          "result = $contains($lowercase(expects_data.userText), \"simulate-failure\") ? \"failure\" : \"success\""
        ]
      },
      "transitions": {
        "success": "probe_in_progress",
        "failure": "cleanup_failure",
        "error": "cleanup_failure"
      }
    },
    "write_reply": {
      "description": "Append the assistant reply via MCP stage-ai-response-and-any-attachments",
      "expects_data": ["serverUrl", "boardId", "cardId", "replyText", "turnId"],
      "produces_data": ["replyId"],
      "input_validations": [
        "$type(serverUrl) = \"string\" and $length(serverUrl) > 0",
        "$type(boardId) = \"string\" and $length(boardId) > 0",
        "$type(cardId) = \"string\" and $length(cardId) > 0",
        "$type(replyText) = \"string\""
      ],
      "handler": {
        "type": "ref",
        "howToRun": "http:post",
        "whatToRun": {
          "kind": "http-url",
          "value": ""
        },
        "meta": "chat-handler",
        "argsMassaging": {
          "urlTemplate": "serverUrl & '/api/boards/' & boardId & '/mcp'",
          "bodyTemplate": "{ 'tool': 'stage-ai-response-and-any-attachments', 'args': { 'card_id': cardId, 'text': replyText, 'turn_id': turnId } }"
        },
        "outputTransforms": {
          "dataTemplate": "{ 'replyId': output.data.id }"
        }
      },
      "transitions": {
        "success": "clear_processing_done",
        "failure": "cleanup_failure",
        "error": "cleanup_failure"
      }
    },
    "clear_processing_done": {
      "description": "Clear processing through the runtime MCP controlplane",
      "expects_data": ["serverUrl", "boardId", "cardId"],
      "input_validations": [
        "$type(serverUrl) = \"string\" and $length(serverUrl) > 0",
        "$type(boardId) = \"string\" and $length(boardId) > 0",
        "$type(cardId) = \"string\" and $length(cardId) > 0"
      ],
      "handler": {
        "type": "ref",
        "howToRun": "http:post",
        "whatToRun": {
          "kind": "http-url",
          "value": ""
        },
        "argsMassaging": {
          "urlTemplate": "serverUrl & '/api/boards/' & boardId & '/mcp-controlplane'",
          "bodyTemplate": "{ 'tool': 'setstate.chat-processing-done', 'args': { 'board_id': boardId, 'card_id': cardId } }"
        },
        "meta": "chat-handler"
      },
      "transitions": {
        "success": "completed",
        "failure": "failed",
        "error": "failed"
      }
    },
    "cleanup_failure": {
      "description": "Write a failure system message via the host test endpoint",
      "expects_data": ["serverUrl", "boardId", "cardId", "turnId"],
      "input_validations": [
        "$type(serverUrl) = \"string\" and $length(serverUrl) > 0",
        "$type(boardId) = \"string\" and $length(boardId) > 0",
        "$type(cardId) = \"string\" and $length(cardId) > 0"
      ],
      "handler": {
        "type": "ref",
        "howToRun": "http:post",
        "whatToRun": {
          "kind": "http-url",
          "value": ""
        },
        "meta": "chat-handler",
        "argsMassaging": {
          "urlTemplate": "serverUrl & '/test-req/boards/' & boardId & '/chat/system-message'",
          "bodyTemplate": "{ 'cardId': cardId, 'text': 'AI response failed - the assistant could not generate a reply. Check server configuration and logs.', 'turn': turnId, 'files': [] }"
        }
      },
      "transitions": {
        "success": "clear_processing_done_failure",
        "failure": "failed",
        "error": "failed"
      }
    },
    "clear_processing_done_failure": {
      "description": "Clear processing through the runtime MCP controlplane after failure cleanup",
      "expects_data": ["serverUrl", "boardId", "cardId"],
      "input_validations": [
        "$type(serverUrl) = \"string\" and $length(serverUrl) > 0",
        "$type(boardId) = \"string\" and $length(boardId) > 0",
        "$type(cardId) = \"string\" and $length(cardId) > 0"
      ],
      "handler": {
        "type": "ref",
        "howToRun": "http:post",
        "whatToRun": {
          "kind": "http-url",
          "value": ""
        },
        "argsMassaging": {
          "urlTemplate": "serverUrl & '/api/boards/' & boardId & '/mcp-controlplane'",
          "bodyTemplate": "{ 'tool': 'setstate.chat-processing-done', 'args': { 'board_id': boardId, 'card_id': cardId } }"
        },
        "meta": "chat-handler"
      },
      "transitions": {
        "success": "failed",
        "failure": "failed",
        "error": "failed"
      }
    }
  },
  "terminal_states": {
    "completed": {
      "description": "Chat response written",
      "return_intent": "success",
      "return_artifacts": false
    },
    "failed": {
      "description": "Chat response failed",
      "return_intent": "failure",
      "return_artifacts": false
    }
  }
}
