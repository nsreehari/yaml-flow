{
  "id": "demo-chat-echo",
  "settings": {
    "start_step": "respond",
    "max_total_steps": 5,
    "timeout_ms": 10000
  },
  "steps": {
    "respond": {
      "description": "Echo the latest chat message back into the card chat log",
      "handler": {
        "type": "ref",
        "howToRun": "local-node",
        "whatToRun": {
          "kind": "fs-path",
          "value": "./demo-chat-echo.js"
        },
        "meta": "chat-handler"
      },
      "transitions": {
        "success": "completed",
        "failure": "failed"
      }
    }
  },
  "terminal_states": {
    "completed": {
      "description": "Echo chat response written",
      "return_intent": "success",
      "return_artifacts": false
    },
    "failed": {
      "description": "Echo chat response failed",
      "return_intent": "failure",
      "return_artifacts": false
    }
  }
}